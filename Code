import os
import gradio as gr
from transformers import AutoModelForCausalLM, AutoTokenizer
import torch


#Load model + tokenizer
hf_token = os.getenv("HF_TOKEN")
model_name = "microsoft/DialoGPT-medium"


tokenizer = AutoTokenizer.from_pretrained(model_name, token=hf_token)
model = AutoModelForCausalLM.from_pretrained(model_name, token=hf_token)


# Chat response logic
def respond(message, history):
    input_ids = tokenizer.encode(message + tokenizer.eos_token, return_tensors='pt')
    
    output_ids = model.generate(
        input_ids, 
        max_new_tokens=500, 
        pad_token_id=tokenizer.eos_token_id,
    )
    
    response = tokenizer.decode(output_ids[:, input_ids.shape[-1]:], skip_special_tokens=True)
        
    return response


# Gradio Interface
sassy_css = ".gradio-container { background-color: #ffe4e1; }"  #Soft pink background

with gr.Blocks(theme=gr.themes.Soft(), css=sassy_css) as demo:
    gr.Markdown("# 🤖 Serena Chatbot\n*Serena is happy to chat but she can be sassy at times.*")


    gr.ChatInterface(
        respond,
        chatbot=gr.Chatbot(label="Serena"),
        #Conversation starter examples
        examples=[
            "Give me a life tip", 
            "Who are you?"],
        cache_examples=False
    )


# Run the app
if __name__ == "__main__":
    demo.launch()
